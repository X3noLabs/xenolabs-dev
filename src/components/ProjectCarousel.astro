---
import { projects } from '../data/projects';
import ProjectMockup from './ProjectMockup.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="relative" id="project-carousel">
  <div class="overflow-hidden rounded-2xl" id="carousel-track-wrap">
    <div class="flex transition-transform duration-500 ease-out" id="carousel-track">
      {projects.map((project) => (
        <div class="w-full shrink-0 px-1">
          <a href={`/${lang}/projects/#${project.slug}`} class="group grid gap-6 rounded-2xl border border-fg/10 bg-surface p-4 transition-colors hover:border-fg/20 sm:grid-cols-2 sm:p-6">
            <div class="aspect-[8/5] overflow-hidden rounded-xl">
              <ProjectMockup name={project.name[lang]} accent={project.accent} />
            </div>
            <div class="flex flex-col justify-center">
              <p class="text-xs font-medium uppercase tracking-wide text-fg/40">{project.stack.slice(0, 3).join(' · ')}</p>
              <h3 class="mt-2 font-display text-xl font-medium text-fg">{project.name[lang]}</h3>
              <p class="mt-2 text-fg/60">{project.tagline[lang]}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-light">
                {lang === 'en' ? 'See project' : 'Ver proyecto'}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-5 flex items-center justify-center gap-4">
    <button id="carousel-prev" aria-label="Previous project" class="flex h-9 w-9 items-center justify-center rounded-full border border-fg/10 text-fg transition-colors hover:bg-fg hover:text-bg">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <div class="flex gap-1.5" id="carousel-dots">
      {projects.map((_, i) => (
        <span data-dot={i} class="h-1.5 w-1.5 rounded-full bg-fg/15 transition-colors"></span>
      ))}
    </div>
    <button id="carousel-next" aria-label="Next project" class="flex h-9 w-9 items-center justify-center rounded-full border border-fg/10 text-fg transition-colors hover:bg-fg hover:text-bg">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</div>

<script>
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const dots = Array.from(document.querySelectorAll<HTMLSpanElement>('#carousel-dots [data-dot]'));
  const slideCount = dots.length;
  let index = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  function render() {
    if (!track) return;
    track.style.transform = `translateX(-${index * 100}%)`;
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-fg/60', i === index);
      dot.classList.toggle('bg-fg/15', i !== index);
    });
  }

  function go(delta: number) {
    index = (index + delta + slideCount) % slideCount;
    render();
  }

  function startAutoplay() {
    timer = setInterval(() => go(1), 6000);
  }

  function stopAutoplay() {
    if (timer) clearInterval(timer);
  }

  prevBtn?.addEventListener('click', () => {
    stopAutoplay();
    go(-1);
  });
  nextBtn?.addEventListener('click', () => {
    stopAutoplay();
    go(1);
  });
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      stopAutoplay();
      index = i;
      render();
    });
  });

  const wrap = document.getElementById('project-carousel');
  wrap?.addEventListener('mouseenter', stopAutoplay);
  wrap?.addEventListener('mouseleave', startAutoplay);

  render();
  startAutoplay();
</script>
