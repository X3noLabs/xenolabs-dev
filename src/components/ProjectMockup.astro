---
interface Props {
  name: string;
  accent: string;
}

const { name, accent } = Astro.props;
const gradientId = `grad-${name.replace(/\s+/g, '-').toLowerCase()}`;
---

<svg viewBox="0 0 480 300" xmlns="http://www.w3.org/2000/svg" class="h-full w-full" role="img" aria-label={`Placeholder preview for ${name}`}>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={accent} stop-opacity="0.9" />
      <stop offset="100%" stop-color={accent} stop-opacity="0.55" />
    </linearGradient>
  </defs>

  <rect width="480" height="300" rx="14" fill="white" />
  <rect width="480" height="300" rx="14" fill={`url(#${gradientId})`} opacity="0.08" />

  <rect x="0" y="0" width="480" height="34" rx="14" fill="#f4f4f5" />
  <rect x="0" y="20" width="480" height="14" fill="#f4f4f5" />
  <circle cx="20" cy="17" r="5" fill="#e4e4e7" />
  <circle cx="38" cy="17" r="5" fill="#e4e4e7" />
  <circle cx="56" cy="17" r="5" fill="#e4e4e7" />
  <rect x="90" y="10" width="300" height="14" rx="7" fill="#e4e4e7" />

  <rect x="24" y="58" width="200" height="16" rx="4" fill={accent} opacity="0.85" />
  <rect x="24" y="86" width="280" height="10" rx="4" fill="#d4d4d8" />
  <rect x="24" y="104" width="240" height="10" rx="4" fill="#e4e4e7" />

  <rect x="24" y="136" width="130" height="90" rx="10" fill={accent} opacity="0.18" />
  <rect x="166" y="136" width="130" height="90" rx="10" fill={accent} opacity="0.12" />
  <rect x="308" y="136" width="148" height="90" rx="10" fill={accent} opacity="0.08" />

  <rect x="24" y="248" width="90" height="28" rx="14" fill={accent} />
  <rect x="126" y="248" width="90" height="28" rx="14" fill="#f4f4f5" />
</svg>
