---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/opsz.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // Pages that shouldn't be indexed or have locale alternates (e.g. the 404).
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const SITE = 'https://xenolabs.dev';
const pathname = Astro.url.pathname;
const fullTitle = `${title} · Xeno Labs`;
const ogImage = `${SITE}/og-${lang}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Xeno Labs',
  url: SITE,
  logo: `${SITE}/apple-touch-icon.png`,
  image: `${SITE}/og-en.png`,
  description:
    'Custom AI agents, internal tools, and integrations for small businesses and teams.',
  areaServed: 'Worldwide',
  address: [
    { '@type': 'PostalAddress', addressCountry: 'MX' },
    { '@type': 'PostalAddress', addressCountry: 'AU' },
  ],
  founder: { '@type': 'Person', name: 'Ike', jobTitle: 'IT & Automation Specialist' },
  sameAs: ['https://github.com/X3noLabs'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="alternate" hreflang="en" href={`${SITE}${pathname.replace(`/${lang}/`, '/en/')}`} />
        <link rel="alternate" hreflang="es" href={`${SITE}${pathname.replace(`/${lang}/`, '/es/')}`} />
        <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
        <link rel="canonical" href={`${SITE}${pathname}`} />
      </>
    )}

    <meta property="og:site_name" content="Xeno Labs" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}${pathname}`} />
    <meta property="og:locale" content={lang === 'en' ? 'en_AU' : 'es_MX'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_MX' : 'en_AU'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Xeno Labs — AI agents & automation" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
