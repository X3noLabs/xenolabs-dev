---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'en';
---

<BaseLayout
  lang={lang}
  title="Contact"
  description="Get in touch about a project, or request a free 30-minute intro call."
>
  <section class="container-page py-16 sm:py-24">
    <div class="mx-auto max-w-xl">
      <p class="text-center text-sm font-medium text-accent">Contact</p>
      <h1 class="mt-4 text-center text-3xl font-bold tracking-tight sm:text-4xl">Let's talk about it.</h1>
      <p class="mt-5 text-center text-ink/60">
        Send a few details about what you're working on, or ask for a free
        30-minute intro call. I read everything myself and reply personally.
      </p>

      <form id="contact-form" class="mt-12 space-y-5" novalidate>
        <div>
          <label for="name" class="text-sm font-medium">Name</label>
          <input id="name" name="name" type="text" required
            class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-sm outline-none transition-colors focus:border-accent" />
        </div>

        <div>
          <label for="email" class="text-sm font-medium">Email</label>
          <input id="email" name="email" type="email" required
            class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-sm outline-none transition-colors focus:border-accent" />
        </div>

        <div>
          <label for="message" class="text-sm font-medium">Message</label>
          <textarea id="message" name="message" rows="5" required
            class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-sm outline-none transition-colors focus:border-accent"></textarea>
        </div>

        <div class="rounded-lg border border-ink/10 bg-white p-4">
          <label class="flex cursor-pointer items-start gap-3 text-sm">
            <input id="wants-call" name="wantsCall" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-ink/30 text-accent focus:ring-accent" />
            <span>
              <span class="font-medium">I'd like to request a free 30-minute intro call.</span>
              <span class="block text-ink/50">Pick a date and time that works for you — I'll confirm by email.</span>
            </span>
          </label>

          <div id="call-time-wrap" class="mt-4 hidden">
            <label for="call-time" class="text-sm font-medium">Preferred date & time</label>
            <input id="call-time" name="callTime" type="datetime-local"
              class="mt-1.5 w-full rounded-lg border border-ink/15 bg-white px-4 py-2.5 text-sm outline-none transition-colors focus:border-accent" />
            <p class="mt-1.5 text-xs text-ink/45">In your local timezone. This is a preference, not a confirmed booking.</p>
          </div>
        </div>

        <button id="submit-btn" type="submit"
          class="w-full rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-transform hover:scale-[1.01] disabled:opacity-50">
          Send message
        </button>

        <p id="form-error" class="hidden text-center text-sm text-red-600"></p>
      </form>

      <div id="form-success" class="hidden mt-12 rounded-2xl border border-ink/5 bg-white p-8 text-center">
        <p class="text-lg font-semibold">Thanks — I'll be in touch soon.</p>
        <p class="mt-2 text-sm text-ink/60">Your message is on its way. I usually reply within a day or two.</p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const wantsCall = document.getElementById('wants-call') as HTMLInputElement | null;
    const callTimeWrap = document.getElementById('call-time-wrap');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const errorEl = document.getElementById('form-error');
    const successEl = document.getElementById('form-success');

    wantsCall?.addEventListener('change', () => {
      callTimeWrap?.classList.toggle('hidden', !wantsCall.checked);
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        message: String(data.get('message') || ''),
        wantsCall: data.get('wantsCall') === 'on',
        callTime: String(data.get('callTime') || ''),
        locale: 'en',
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error('Request failed');

        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = "Something went wrong sending that — mind trying again in a moment?";
          errorEl.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send message';
        }
      }
    });
  </script>
</BaseLayout>
