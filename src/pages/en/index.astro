---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechMarquee from '../../components/TechMarquee.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';

const lang = 'en';
---

<BaseLayout
  lang={lang}
  title="AI Agents & Automation"
  description="Xeno Labs builds custom AI agents, internal tools, and integrations that take repetitive work off your plate — built by Ike, an IT & automation specialist based in Guanajuato, Mexico."
>
  <section class="container-page pt-16 pb-14 sm:pt-24 sm:pb-20">
    <div class="max-w-2xl animate-fade-up">
      <p class="text-sm font-medium text-accent">Xeno Labs</p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
        AI agents and automation that quietly take the busywork off your plate.
      </h1>
      <p class="mt-6 text-lg text-ink/60">
        I design and build custom AI agents, internal tools, and integrations for small
        businesses and teams — the kind of practical automation that saves a few hours
        every week, without needing an engineering department to run it.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/en/services/" class="rounded-full bg-ink px-5 py-3 text-sm font-medium text-paper transition-transform hover:scale-[1.02]">
          See what I do
        </a>
        <a href="/en/contact/" class="rounded-full border border-ink/15 px-5 py-3 text-sm font-medium transition-colors hover:bg-ink/5">
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-ink/5 bg-white/60">
    <div class="container-page">
      <TechMarquee />
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mb-10 max-w-xl">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">What I do</h2>
      <p class="mt-3 text-ink/60">
        Three ways I usually end up helping — most projects are a mix of two.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      {[
        {
          title: 'AI Agents & Automation',
          body: 'Custom agents that handle the repetitive stuff — sorting, drafting, checking, chasing — so you don’t have to.',
        },
        {
          title: 'Internal Tools & Apps',
          body: 'Purpose-built apps for the one workflow off-the-shelf software never quite fits.',
        },
        {
          title: 'Integration & APIs',
          body: 'Connecting the tools you already use so information moves on its own.',
        },
      ].map((item) => (
        <div class="rounded-2xl border border-ink/5 bg-white p-6">
          <h3 class="font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm text-ink/60">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-xl">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Some things I've built</h2>
        <p class="mt-3 text-ink/60">A few recent projects, from personal tools to client work.</p>
      </div>
      <a href="/en/projects/" class="text-sm font-medium text-accent hover:underline">View all projects →</a>
    </div>
    <ProjectCarousel lang={lang} />
  </section>

  <section class="container-page pb-20 sm:pb-28">
    <div class="rounded-3xl bg-ink px-8 py-14 text-center text-paper sm:px-16">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        Got something eating up your week?
      </h2>
      <p class="mx-auto mt-3 max-w-md text-paper/70">
        Tell me what it is and I'll tell you honestly whether automation is worth it.
      </p>
      <a href="/en/contact/" class="mt-7 inline-block rounded-full bg-paper px-6 py-3 text-sm font-medium text-ink transition-transform hover:scale-[1.02]">
        Start the conversation
      </a>
    </div>
  </section>
</BaseLayout>
