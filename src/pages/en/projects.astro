---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMockup from '../../components/ProjectMockup.astro';
import { projects } from '../../data/projects';

const lang = 'en';
---

<BaseLayout
  lang={lang}
  title="Projects"
  description="A look at what I've built — from an AI voice assistant for the car to internal tools and client websites."
>
  <section class="container-page py-16 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-accent">Projects</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">A few things I've built.</h1>
      <p class="mt-5 text-ink/60">
        A mix of personal projects and client work. Screenshots below are
        placeholder mockups for now — happy to walk through the real thing.
      </p>
    </div>

    <div class="mt-14 space-y-10">
      {projects.map((project) => (
        <article id={project.slug} class="scroll-mt-24 grid gap-6 rounded-2xl border border-ink/5 bg-white p-6 sm:grid-cols-2 sm:p-8">
          <div class="aspect-[8/5] overflow-hidden rounded-xl">
            <ProjectMockup name={project.name[lang]} accent={project.accent} />
          </div>
          <div class="flex flex-col justify-center">
            <div class="flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <span class="rounded-full bg-ink/5 px-2.5 py-1 text-xs font-medium text-ink/60">{tech}</span>
              ))}
            </div>
            <h2 class="mt-3 text-xl font-semibold">{project.name[lang]}</h2>
            <p class="mt-1 text-sm font-medium text-accent">{project.tagline[lang]}</p>
            <p class="mt-3 text-ink/60">{project.description[lang]}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
