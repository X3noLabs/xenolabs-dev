---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'en';

const services = [
  {
    title: 'AI Agents & Automation',
    body: 'Custom agents built to handle repetitive, well-defined tasks — sorting and responding to messages, pulling together reports, checking data, following up on things so they don’t fall through the cracks. Built around what your work actually looks like, not a generic chatbot bolted onto it.',
  },
  {
    title: 'Internal Tools & Apps',
    body: 'Purpose-built apps for the one workflow that off-the-shelf software never quite handles — a project tracker shaped the way your team actually thinks, a gradebook that matches your real rubric, a small dashboard instead of a spreadsheet nobody trusts anymore.',
  },
  {
    title: 'Integration & APIs',
    body: 'Connecting the tools you already use — the Claude API, Google Calendar, your CRM, whatever else — so information moves between them on its own instead of being copied and pasted by hand.',
  },
  {
    title: 'Consulting',
    body: 'An outside look at where automation would actually help versus where it wouldn’t. Sometimes the answer is a small script, sometimes it’s nothing at all — I’ll tell you which.',
  },
];

const steps = [
  { title: 'Discover', body: 'A conversation about what’s actually eating up your time, and whether automation is a good fit for it.' },
  { title: 'Build', body: 'I design and build the thing, checking in as it takes shape rather than disappearing for weeks.' },
  { title: 'Deploy', body: 'It goes live in your workflow, tested against how you’ll actually use it, not just in theory.' },
  { title: 'Support', body: 'I stick around after launch — things change, and the tool should keep up.' },
];
---

<BaseLayout
  lang={lang}
  title="Services"
  description="AI agents & automation, internal tools, integrations, and consulting — practical services to take repetitive work off your plate."
>
  <section class="container-page py-16 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-accent">Services</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        A few ways I can help, depending on what's slowing you down.
      </h1>
      <p class="mt-5 text-ink/60">
        Most projects end up being a mix of these — an agent that needs an
        integration to actually be useful, a tool that needs a bit of consulting
        first to scope properly.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {services.map((service) => (
        <div class="rounded-2xl border border-ink/5 bg-white p-7">
          <h2 class="text-lg font-semibold">{service.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink/60">{service.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-ink/5 bg-white/60 py-16 sm:py-20">
    <div class="container-page">
      <div class="max-w-xl">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">How it works</h2>
        <p class="mt-3 text-ink/60">A straightforward process, start to finish.</p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-4">
        {steps.map((step, i) => (
          <div>
            <span class="text-sm font-semibold text-accent">0{i + 1}</span>
            <h3 class="mt-2 font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-ink/60">{step.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <a href="/en/contact/" class="inline-block rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-transform hover:scale-[1.02]">
          Tell me what you're working with
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
