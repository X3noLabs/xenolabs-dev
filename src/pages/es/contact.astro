---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'es';
---

<BaseLayout
  lang={lang}
  title="Contacto"
  description="Ponte en contacto para platicar sobre un proyecto, o pide una llamada de presentación gratis de 30 minutos."
>
  <section class="container-page py-20 sm:py-28">
    <div class="mx-auto max-w-xl">
      <p class="text-center text-sm font-medium text-accent-light">Contacto</p>
      <h1 class="mt-4 text-center font-display text-4xl font-medium tracking-tight text-fg sm:text-5xl">Platiquemos.</h1>
      <p class="mt-5 text-center text-fg/60">
        Cuéntame algunos detalles sobre lo que traes entre manos, o pide una
        llamada de presentación gratis de 30 minutos. Leo todo personalmente y
        respondo yo mismo.
      </p>

      <form id="contact-form" class="mt-12 space-y-5" novalidate>
        <div>
          <label for="name" class="text-sm font-medium text-fg">Nombre</label>
          <input id="name" name="name" type="text" required
            class="mt-1.5 w-full rounded-lg border border-fg/15 bg-surface px-4 py-2.5 text-sm text-fg outline-none transition-colors focus:border-accent-light" />
        </div>

        <div>
          <label for="email" class="text-sm font-medium text-fg">Correo</label>
          <input id="email" name="email" type="email" required
            class="mt-1.5 w-full rounded-lg border border-fg/15 bg-surface px-4 py-2.5 text-sm text-fg outline-none transition-colors focus:border-accent-light" />
        </div>

        <div>
          <label for="message" class="text-sm font-medium text-fg">Mensaje</label>
          <textarea id="message" name="message" rows="5" required
            class="mt-1.5 w-full rounded-lg border border-fg/15 bg-surface px-4 py-2.5 text-sm text-fg outline-none transition-colors focus:border-accent-light"></textarea>
        </div>

        <div class="rounded-lg border border-fg/10 bg-surface p-4">
          <label class="flex cursor-pointer items-start gap-3 text-sm text-fg">
            <input id="wants-call" name="wantsCall" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-fg/30 bg-transparent text-accent focus:ring-accent-light" />
            <span>
              <span class="font-medium">Quiero pedir una llamada de presentación gratis de 30 minutos.</span>
              <span class="block text-fg/50">Elige una fecha y hora que te acomode — te confirmo por correo.</span>
            </span>
          </label>

          <div id="call-time-wrap" class="mt-4 hidden">
            <label for="call-time" class="text-sm font-medium text-fg">Fecha y hora preferida</label>
            <input id="call-time" name="callTime" type="datetime-local"
              class="mt-1.5 w-full rounded-lg border border-fg/15 bg-surface px-4 py-2.5 text-sm text-fg outline-none transition-colors focus:border-accent-light [color-scheme:dark]" />
            <p class="mt-1.5 text-xs text-fg/45">En tu horario local. Esto es una preferencia, no una reservación confirmada.</p>
          </div>
        </div>

        <button id="submit-btn" type="submit"
          class="w-full rounded-full bg-fg px-6 py-3 text-sm font-semibold text-bg transition-transform hover:scale-[1.01] disabled:opacity-50">
          Enviar mensaje
        </button>

        <p id="form-error" class="hidden text-center text-sm text-red-400"></p>
      </form>

      <div id="form-success" class="hidden mt-12 rounded-2xl border border-fg/10 bg-surface p-8 text-center">
        <p class="text-lg font-semibold text-fg">Gracias — pronto me pondré en contacto.</p>
        <p class="mt-2 text-sm text-fg/60">Tu mensaje ya va en camino. Normalmente respondo en uno o dos días.</p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const wantsCall = document.getElementById('wants-call') as HTMLInputElement | null;
    const callTimeWrap = document.getElementById('call-time-wrap');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const errorEl = document.getElementById('form-error');
    const successEl = document.getElementById('form-success');

    wantsCall?.addEventListener('change', () => {
      callTimeWrap?.classList.toggle('hidden', !wantsCall.checked);
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando…';
      }

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        message: String(data.get('message') || ''),
        wantsCall: data.get('wantsCall') === 'on',
        callTime: String(data.get('callTime') || ''),
        locale: 'es',
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error('Request failed');

        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = 'Algo falló al enviar eso — ¿puedes intentar de nuevo en un momento?';
          errorEl.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar mensaje';
        }
      }
    });
  </script>
</BaseLayout>
