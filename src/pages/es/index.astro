---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechMarquee from '../../components/TechMarquee.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';

const lang = 'es';
---

<BaseLayout
  lang={lang}
  title="Agentes de IA y Automatización"
  description="Xeno Labs construye agentes de IA, herramientas internas e integraciones a la medida que te quitan trabajo repetitivo de encima — hecho por Ike, especialista en TI y automatización con base en Guanajuato, México."
>
  <section class="container-page pt-16 pb-14 sm:pt-24 sm:pb-20">
    <div class="max-w-2xl animate-fade-up">
      <p class="text-sm font-medium text-accent">Xeno Labs</p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
        Agentes de IA y automatización que le quitan el trabajo pesado de encima, sin hacer ruido.
      </h1>
      <p class="mt-6 text-lg text-ink/60">
        Diseño y construyo agentes de IA, herramientas internas e integraciones a la
        medida para negocios y equipos pequeños — automatización práctica que te
        ahorra varias horas a la semana, sin necesitar todo un equipo de sistemas
        para mantenerla funcionando.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/es/services/" class="rounded-full bg-ink px-5 py-3 text-sm font-medium text-paper transition-transform hover:scale-[1.02]">
          Ve lo que hago
        </a>
        <a href="/es/contact/" class="rounded-full border border-ink/15 px-5 py-3 text-sm font-medium transition-colors hover:bg-ink/5">
          Contáctame
        </a>
      </div>
    </div>
  </section>

  <section class="border-y border-ink/5 bg-white/60">
    <div class="container-page">
      <TechMarquee />
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mb-10 max-w-xl">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Lo que hago</h2>
      <p class="mt-3 text-ink/60">
        Tres formas en las que normalmente termino ayudando — la mayoría de los
        proyectos combinan dos de ellas.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      {[
        {
          title: 'Agentes de IA y Automatización',
          body: 'Agentes hechos a la medida que se encargan de lo repetitivo — clasificar, redactar, revisar, dar seguimiento — para que tú no tengas que hacerlo.',
        },
        {
          title: 'Herramientas y Apps Internas',
          body: 'Apps diseñadas específicamente para ese flujo de trabajo que el software genérico nunca termina de encajar bien.',
        },
        {
          title: 'Integración y APIs',
          body: 'Conecto las herramientas que ya usas para que la información se mueva sola entre ellas.',
        },
      ].map((item) => (
        <div class="rounded-2xl border border-ink/5 bg-white p-6">
          <h3 class="font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm text-ink/60">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-xl">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Algunas cosas que he construido</h2>
        <p class="mt-3 text-ink/60">Algunos proyectos recientes, desde herramientas personales hasta trabajo con clientes.</p>
      </div>
      <a href="/es/projects/" class="text-sm font-medium text-accent hover:underline">Ver todos los proyectos →</a>
    </div>
    <ProjectCarousel lang={lang} />
  </section>

  <section class="container-page pb-20 sm:pb-28">
    <div class="rounded-3xl bg-ink px-8 py-14 text-center text-paper sm:px-16">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        ¿Hay algo que te esté quitando la semana entera?
      </h2>
      <p class="mx-auto mt-3 max-w-md text-paper/70">
        Cuéntame qué es y te digo honestamente si vale la pena automatizarlo.
      </p>
      <a href="/es/contact/" class="mt-7 inline-block rounded-full bg-paper px-6 py-3 text-sm font-medium text-ink transition-transform hover:scale-[1.02]">
        Empecemos a platicar
      </a>
    </div>
  </section>
</BaseLayout>
