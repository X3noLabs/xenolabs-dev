---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMockup from '../../components/ProjectMockup.astro';
import CompareSlider from '../../components/CompareSlider.astro';
import ScreenshotLightbox from '../../components/ScreenshotLightbox.astro';
import { projects, localizedShot } from '../../data/projects';

const lang = 'es';
---

<BaseLayout
  lang={lang}
  title="Proyectos"
  description="Un vistazo a lo que he construido — desde un asistente de voz con IA para el carro hasta herramientas internas, un juego familiar y un sistema de IA multiagente."
>
  <section class="container-page py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-accent-light">Proyectos</p>
      <h1 class="mt-4 font-display text-4xl font-medium tracking-tight text-fg sm:text-5xl">Algunas cosas que he construido.</h1>
      <p class="mt-5 text-fg/60">
        Una mezcla de herramientas que uso a diario y apps hechas para la gente
        a mi alrededor — cada una pensada para resolver un problema real y
        concreto.
      </p>
    </div>

    <div class="mt-14 space-y-10">
      {projects.map((project) => (
        <article id={project.slug} class="scroll-mt-24 grid gap-6 rounded-2xl border border-fg/10 bg-surface p-6 sm:grid-cols-2 sm:p-8">
          <div class="group relative aspect-[8/5] overflow-hidden rounded-xl">
            {project.compare ? (
              <>
                <CompareSlider
                  before={localizedShot(project.compare.before, lang)}
                  after={localizedShot(project.compare.after, lang)}
                  labels={project.compare.labels}
                  alt={`Página de inicio de ${project.name[lang]}`}
                  ariaLabel={`Desliza para comparar ${project.compare.labels[0]} y ${project.compare.labels[1]}`}
                />
                {project.screenshots && project.screenshots.length > 0 && (
                  <button
                    type="button"
                    data-lightbox-trigger
                    data-images={JSON.stringify(project.screenshots.map((src) => localizedShot(src, lang)))}
                    data-index="0"
                    class="absolute right-3 top-3 z-10 rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium text-fg transition-colors hover:bg-fg hover:text-bg"
                  >
                    {`Ver ${project.screenshots.length} fotos`}
                  </button>
                )}
              </>
            ) : project.screenshots && project.screenshots.length > 0 ? (
              <button
                type="button"
                data-lightbox-trigger
                data-images={JSON.stringify(project.screenshots.map((src) => localizedShot(src, lang)))}
                data-index="0"
                class="block h-full w-full cursor-zoom-in"
                aria-label={`Ampliar capturas de ${project.name[lang]}`}
              >
                <img src={localizedShot(project.screenshots[0], lang)} alt={`Captura de ${project.name[lang]}`} class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
                <span class="pointer-events-none absolute inset-0 flex items-end justify-end bg-bg/0 p-3 opacity-0 transition-opacity group-hover:bg-bg/20 group-hover:opacity-100">
                  <span class="rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium text-fg">
                    {project.screenshots.length > 1 ? `Ver ${project.screenshots.length} fotos` : 'Ver foto'}
                  </span>
                </span>
              </button>
            ) : (
              <ProjectMockup name={project.name[lang]} accent={project.accent} />
            )}
          </div>
          <div class="flex flex-col justify-center">
            <div class="flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <span class="rounded-full bg-fg/5 px-2.5 py-1 text-xs font-medium text-fg/60">{tech}</span>
              ))}
            </div>
            <h2 class="mt-3 font-display text-xl font-medium text-fg">{project.name[lang]}</h2>
            <p class="mt-1 text-sm font-medium text-accent-light">{project.tagline[lang]}</p>
            <p class="mt-3 text-fg/60">{project.description[lang]}</p>
            {project.caseStudy && (
              <a href={`/es/projects/${project.caseStudy}/`} class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-light underline-offset-4 hover:underline">
                Leer el caso de estudio <span aria-hidden="true">→</span>
              </a>
            )}
            {project.links && project.links.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                {project.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener" class="font-medium text-accent-light underline-offset-4 hover:underline">
                    {link.label} <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <ScreenshotLightbox />
</BaseLayout>
