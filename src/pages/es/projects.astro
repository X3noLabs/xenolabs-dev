---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMockup from '../../components/ProjectMockup.astro';
import { projects } from '../../data/projects';

const lang = 'es';
---

<BaseLayout
  lang={lang}
  title="Proyectos"
  description="Un vistazo a lo que he construido — desde un asistente de voz con IA para el coche hasta herramientas internas y sitios web para clientes."
>
  <section class="container-page py-16 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-accent">Proyectos</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Algunas cosas que he construido.</h1>
      <p class="mt-5 text-ink/60">
        Una mezcla de proyectos personales y trabajo con clientes. Las capturas de
        abajo son mockups de marcador de posición por ahora — con gusto te
        muestro lo real en una llamada.
      </p>
    </div>

    <div class="mt-14 space-y-10">
      {projects.map((project) => (
        <article id={project.slug} class="scroll-mt-24 grid gap-6 rounded-2xl border border-ink/5 bg-white p-6 sm:grid-cols-2 sm:p-8">
          <div class="aspect-[8/5] overflow-hidden rounded-xl">
            <ProjectMockup name={project.name[lang]} accent={project.accent} />
          </div>
          <div class="flex flex-col justify-center">
            <div class="flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <span class="rounded-full bg-ink/5 px-2.5 py-1 text-xs font-medium text-ink/60">{tech}</span>
              ))}
            </div>
            <h2 class="mt-3 text-xl font-semibold">{project.name[lang]}</h2>
            <p class="mt-1 text-sm font-medium text-accent">{project.tagline[lang]}</p>
            <p class="mt-3 text-ink/60">{project.description[lang]}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
