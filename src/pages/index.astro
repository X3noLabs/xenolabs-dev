---
// Static entry point: detects a returning visitor's saved locale, otherwise
// falls back to the browser's language list, then to English. Runs client-side
// because the site is fully static (Cloudflare Pages has no header-reading
// middleware here) — see README for the reasoning.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <title>Xeno Labs · AI Agents & Automation</title>
    <!-- Link-preview scrapers don't run the redirect below, so a shared bare
         xenolabs.dev link needs its own OG tags. -->
    <meta name="description" content="Custom AI agents, internal tools, and integrations that take repetitive work off your plate." />
    <link rel="alternate" hreflang="en" href="https://xenolabs.dev/en/" />
    <link rel="alternate" hreflang="es" href="https://xenolabs.dev/es/" />
    <link rel="alternate" hreflang="x-default" href="https://xenolabs.dev/" />
    <meta property="og:site_name" content="Xeno Labs" />
    <meta property="og:title" content="Xeno Labs · AI Agents & Automation" />
    <meta property="og:description" content="Custom AI agents, internal tools, and integrations that take repetitive work off your plate." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://xenolabs.dev/" />
    <meta property="og:image" content="https://xenolabs.dev/og-en.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://xenolabs.dev/og-en.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script>
      const SUPPORTED = ['en', 'es'];
      const saved = localStorage.getItem('xl_locale');
      let target = 'en';

      if (saved && SUPPORTED.includes(saved)) {
        target = saved;
      } else {
        const browserLangs = navigator.languages ?? [navigator.language];
        const match = browserLangs
          .map((l) => l.split('-')[0].toLowerCase())
          .find((l) => SUPPORTED.includes(l));
        if (match) target = match;
      }

      window.location.replace(`/${target}/`);
    </script>
  </head>
  <body></body>
</html>
